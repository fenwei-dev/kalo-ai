{
	"name": "@kalo-ai/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"dev": "bun run i18n:compile && vite dev",
		"build": "bun run i18n:compile && vite build",
		"preview": "vite preview",
		"prepare": "bun run i18n:compile && svelte-kit sync",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun run i18n:compile && bun test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.23.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@vite-pwa/sveltekit": "^1.1.0",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.1",
		"@earendil-works/pi-ai": "^0.84.1",
		"dexie": "^4.4.4",
		"dompurify": "^3.4.13",
		"konsta": "^5.3.0",
		"layerchart": "^2.1.0",
		"marked": "^18.0.9"
	}
}
